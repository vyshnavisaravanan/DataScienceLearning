    "import numpy as ny\n",
    "\n",
    "fruits = ny.array([\"apple\", \"banana\", \"carrot\"])\n",
    "\n",
    "print(fruits)\n",
    "\n",
    "for i,j in enumerate(fruits):\n",
    "    print(f\"Fruits are {i}{j}\")"
